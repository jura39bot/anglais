[
{"q":"What is your name?","a":"My name is Mathieu.","fr":"Quel est ton nom ?","cat":"identité"},
{"q":"How are you?","a":"I am fine, thank you.","fr":"Comment vas-tu ?","cat":"identité"},
{"q":"Where do you live?","a":"I live in Morez, in the Jura.","fr":"Où habites-tu ?","cat":"identité"},
{"q":"How old are you?","a":"I am forty years old.","fr":"Quel âge as-tu ?","cat":"identité"},
{"q":"What do you do for a living?","a":"I work in IT.","fr":"Que fais-tu comme métier ?","cat":"travail"},
{"q":"Where do you work?","a":"I work from home.","fr":"Où travailles-tu ?","cat":"travail"},
{"q":"What time does it start?","a":"It starts at nine.","fr":"À quelle heure ça commence ?","cat":"temps"},
{"q":"When are you free?","a":"I am free on Friday.","fr":"Quand es-tu libre ?","cat":"temps"},
{"q":"How long does it take?","a":"It takes about an hour.","fr":"Combien de temps ça prend ?","cat":"temps"},
{"q":"How often do you travel?","a":"I travel twice a month.","fr":"Voyages-tu souvent ?","cat":"temps"},
{"q":"How much does it cost?","a":"It costs twenty euros.","fr":"Combien ça coûte ?","cat":"argent"},
{"q":"Can I pay by card?","a":"Yes, of course.","fr":"Je peux payer par carte ?","cat":"argent"},
{"q":"Is it included?","a":"Yes, breakfast is included.","fr":"Est-ce inclus ?","cat":"argent"},
{"q":"Where is the station?","a":"It is five minutes from here.","fr":"Où est la gare ?","cat":"voyage"},
{"q":"How do I get to the centre?","a":"Take the metro, line one.","fr":"Comment aller au centre ?","cat":"voyage"},
{"q":"Which platform is it?","a":"Platform three.","fr":"Quel quai ?","cat":"voyage"},
{"q":"Is there a direct train?","a":"No, you have to change.","fr":"Y a-t-il un train direct ?","cat":"voyage"},
{"q":"Do you have a reservation?","a":"Yes, under my name.","fr":"Avez-vous une réservation ?","cat":"restaurant"},
{"q":"What do you recommend?","a":"I recommend the fish.","fr":"Que recommandez-vous ?","cat":"restaurant"},
{"q":"Could I have the bill, please?","a":"Certainly, one moment.","fr":"L'addition, s'il vous plaît ?","cat":"restaurant"},
{"q":"Do you have a table for two?","a":"Yes, follow me.","fr":"Avez-vous une table pour deux ?","cat":"restaurant"},
{"q":"What does it mean?","a":"It means 'hello'.","fr":"Qu'est-ce que ça veut dire ?","cat":"langue"},
{"q":"How do you say that in English?","a":"You say 'railway station'.","fr":"Comment dit-on ça en anglais ?","cat":"langue"},
{"q":"Can you repeat that, please?","a":"Of course, I will slow down.","fr":"Pouvez-vous répéter ?","cat":"langue"},
{"q":"Could you speak more slowly?","a":"Yes, sorry.","fr":"Pouvez-vous parler plus lentement ?","cat":"langue"},
{"q":"What did you say?","a":"I said we are late.","fr":"Qu'as-tu dit ?","cat":"langue"},
{"q":"Why are you late?","a":"Because of the traffic.","fr":"Pourquoi es-tu en retard ?","cat":"quotidien"},
{"q":"Who is coming with us?","a":"My brother is coming.","fr":"Qui vient avec nous ?","cat":"quotidien"},
{"q":"What are you doing tonight?","a":"I am staying at home.","fr":"Que fais-tu ce soir ?","cat":"quotidien"},
{"q":"Have you finished?","a":"Not yet, almost.","fr":"As-tu fini ?","cat":"quotidien"},
{"q":"Do you agree with me?","a":"Yes, I completely agree.","fr":"Es-tu d'accord avec moi ?","cat":"opinion"},
{"q":"What do you think about it?","a":"I think it is a good idea.","fr":"Qu'en penses-tu ?","cat":"opinion"},
{"q":"Would you like to come?","a":"I would love to.","fr":"Voudrais-tu venir ?","cat":"invitation"},
{"q":"Shall we meet at eight?","a":"Eight works for me.","fr":"On se voit à huit heures ?","cat":"invitation"},
{"q":"Can you help me, please?","a":"Sure, what do you need?","fr":"Peux-tu m'aider ?","cat":"demande"},
